---
import "../styles/global.css";
import Header from "../components/Header.astro";
const { title = "Portafolio – Sebastian" } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
  </head>
  <body class="min-h-dvh bg-white text-gray-900 dark:bg-[#313131] dark:text-white">
    <Header />
    <main class="pt-24"> <!-- espacio por header fijo -->
      <slot />
    </main>
  </body>
</html>
