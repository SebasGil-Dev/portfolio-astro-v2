---
import "../styles/global.css";
import Header from "../components/Header.astro";

const { title = "Portafolio" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
  </head>

  <body class="min-h-dvh bg-white text-gray-900 dark:bg-[#313131] dark:text-white">
    <!-- Header global -->
    <Header />

    <!-- Contenido de cada página -->
    <main class="pt-24">
      <slot />
    </main>

    <!-- Script global de i18n -->
    <script>
      import "../scripts/i18n.ts";
    </script>
  </body>
</html>
