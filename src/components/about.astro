---
/* Rutas de tus CV — ponlos en /public/cv/ */
const CV_ES = "/cv/cv-es.pdf";
const CV_EN = "/cv/cv-en.pdf";
---

<section
  id="sobre-mi"
  class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-16"
  aria-label="Presentación"
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">

    <!-- Columna izquierda: imagen con blob -->
    <div class="relative mx-auto lg:mx-0 w-[min(520px,90vw)] aspect-square flex items-center justify-center">
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-gradient-to-br from-lime-300 via-yellow-300 to-amber-300
               rounded-full blur-3xl opacity-70 dark:opacity-30"
      ></div>

      <img
        src="/profile.png"
        alt="Sebastián Gil"
        class="relative z-10 h-[80%] w-[80%] object-cover rounded-full ring-4 ring-white/30 dark:ring-neutral-800/60
               shadow-2xl transition-transform duration-500 ease-out hover:scale-103"
        loading="eager"
        decoding="async"
      />

      <!-- Botón: Disponible para trabajar -->
      <a
        href="#contacto"
        aria-label="Ir a contacto"
        class="group absolute left-1/2 -translate-x-1/2 bottom-[8%]
              inline-flex items-center transition md:hover:scale-105 z-20"
      >
        <span class="relative inline-flex overflow-hidden rounded-full p-[1px]">
          <span
            class="absolute inset-[-1000%] animate-[spin_2s_linear_infinite]
                  bg-[conic-gradient(from_90deg_at_50%_50%,#15EAAB_0%,#2154E5_50%,#15EAAB_100%)]"
            aria-hidden="true"
          ></span>

          <div
            class="inline-flex items-center justify-center w-full px-3 py-1 text-sm
                  text-green-800 bg-green-100 rounded-full cursor-pointer
                  dark:bg-gray-800 dark:text-white/80 backdrop-blur-3xl whitespace-nowrap"
            data-i18n="about_available"
          >
            Disponible para trabajar
          </div>
        </span>
      </a>

    </div>

    <!-- Columna derecha -->
    <div class="text-center lg:text-left">
      <!-- Título -->
      <h1
        class="flex flex-col justify-center lg:justify-start items-center lg:items-start
               text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight
               text-center lg:text-left"
      >
        <span data-i18n="about_greeting" class="mb-2">Hola, soy</span>
        <span class="relative inline-flex overflow-visible items-baseline">
          <span
            id="typer"
            class="inline-block whitespace-nowrap leading-[1.2] pb-[2px]
                   bg-gradient-to-r from-lime-600 via-lime-500 to-amber-500
                   bg-clip-text text-transparent"
            aria-live="polite"
          ></span>
          <span id="typer-src" class="sr-only" aria-hidden="true">
            <span data-i18n="about_rot1">Sebastián Gil</span>
            <span data-i18n="about_rot2">Ingeniero de Sistemas</span>
            <span data-i18n="about_rot3">Programador</span>
          </span>
        </span>
      </h1>

      <style>
        #typer::after {
          content: "|";
          margin-left: .15em;
          vertical-align: -0.05em;
          color: #16a34a;
          animation: caretBlink 1s step-end infinite;
        }
        @media (prefers-color-scheme: dark) {
          #typer::after { color: #22d3ee; }
        }
        @keyframes caretBlink {
          0%, 49% { opacity: 1; }
          50%,100% { opacity: 0; }
        }
      </style>

      <script is:inline type="module">
        const el = document.getElementById('typer');
        const srcWrap = document.getElementById('typer-src');
        const getPhrases = () =>
          Array.from(srcWrap?.querySelectorAll('span') ?? [])
            .map(s => s.textContent?.trim())
            .filter(Boolean);
        const sleep = (ms) => new Promise(r => setTimeout(r, ms));
        const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
        let abort = new AbortController();

        async function typeLoop({ speed = 60, pause = 1200, erase = 40 } = {}) {
          const signal = abort.signal;
          const phrases = getPhrases();
          if (!el || phrases.length === 0) return;
          if (reduced) {
            el.textContent = phrases[0] || '';
            return;
          }
          let i = 0;
          while (!signal.aborted) {
            const text = phrases[i % phrases.length] || '';
            for (let k = 1; k <= text.length && !signal.aborted; k++) {
              el.textContent = text.slice(0, k);
              await sleep(speed);
            }
            await sleep(pause);
            for (let k = text.length; k >= 0 && !signal.aborted; k--) {
              el.textContent = text.slice(0, k);
              await sleep(erase);
            }
            await sleep(200);
            i++;
          }
        }
        const start = () => {
          abort.abort();
          abort = new AbortController();
          typeLoop({});
        };
        document.addEventListener('DOMContentLoaded', start);
        document.addEventListener('i18n:changed', start);
      </script>

      <!-- Descripción -->
      <p
        class="mt-5 text-base sm:text-[14px] leading-relaxed text-neutral-700 dark:text-neutral-300 max-w-2xl mx-auto lg:mx-0"
        data-i18n="about_description"
      ></p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 mt-6">
        <!-- Botón con menú de idiomas -->
        <details class="relative inline-block" data-cv-menu>
          <summary
            class="list-none inline-flex items-center gap-2 px-5 py-2 rounded-full border border-gray-300
                   bg-white text-gray-800 font-medium text-sm shadow-sm cursor-pointer select-none
                   hover:bg-gray-100 active:scale-[0.98]
                   dark:bg-neutral-900 dark:text-white dark:border-neutral-700 dark:hover:bg-neutral-800
                   transition-all duration-300"
            aria-haspopup="menu"
            aria-expanded="false"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v10m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
            <span data-i18n="about_cv">Descargar CV</span>
            <svg class="w-4 h-4 opacity-60" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd"/></svg>
          </summary>

          <!-- Panel -->
          <div class="absolute left-0 mt-2 w-64 rounded-2xl border border-black/10 dark:border-white/10
                      bg-white/90 dark:bg-neutral-900/90 backdrop-blur shadow-xl p-2 z-30">
            <a href={CV_ES} download class="flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-black/5 dark:hover:bg-white/5 transition">
              <span class="inline-flex items-center justify-center w-10 h-6 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">ES</span>
              <span class="flex-1 text-sm">Descargar en español</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path d="M12 5v10M7 10l5 5 5-5"/><path d="M19 19H5"/></svg>
            </a>

            <a href={CV_EN} download class="mt-1 flex items-center gap-3 px-3 py-2 rounded-xl hover:bg-black/5 dark:hover:bg-white/5 transition">
              <span class="inline-flex items-center justify-center w-10 h-6 text-xs font-semibold rounded-full bg-sky-100 text-sky-700 dark:bg-sky-900/40 dark:text-sky-300">EN</span>
              <span class="flex-1 text-sm">Download in English</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path d="M12 5v10M7 10l5 5 5-5"/><path d="M19 19H5"/></svg>
            </a>
          </div>
        </details>

        <!-- Correo -->
<!-- Botón Correo (copia al portapapeles con icono) -->
<button
  type="button"
  id="copy-email"
  class="relative inline-flex items-center gap-2 px-5 py-2 rounded-full border border-gray-300
         bg-white text-gray-800 font-medium text-sm shadow-sm
         hover:bg-gray-100 active:scale-[0.98]
         dark:bg-neutral-900 dark:text-white dark:border-neutral-700 dark:hover:bg-neutral-800
         transition-all duration-300"
>
  <!-- Icono de correo -->
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-blue-500">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M4 6h16a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V7a1 1 0 011-1z" />
  </svg>

  <span id="email-text">sebastiangildev@gmail.com</span>

  <!-- Icono de copiar -->
  <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
       fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
       stroke-linejoin="round"
       class="w-4 h-4 text-gray-500 dark:text-gray-400 opacity-80 group-hover:opacity-100 transition-opacity duration-300">
    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
  </svg>

  <!-- Tooltip -->
  <span
    id="copied-tooltip"
    class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 text-xs font-medium rounded-md
           bg-black/80 text-white opacity-0 pointer-events-none transition-opacity duration-300"
  >
    Copiado ✔️
  </span>
</button>

<script is:inline>
  const btn = document.getElementById('copy-email');
  const tooltip = document.getElementById('copied-tooltip');
  const icon = document.getElementById('copy-icon');
  const emailText = document.getElementById('email-text').textContent.trim();

  btn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailText);
      tooltip.style.opacity = '1';
      icon.classList.add('text-emerald-500'); // cambia color al copiar
      setTimeout(() => {
        tooltip.style.opacity = '0';
        icon.classList.remove('text-emerald-500');
      }, 1500);
    } catch (err) {
      console.error('Error al copiar el correo:', err);
    }
  });
</script>
</div>

      <!-- Social -->
<!-- Redes sociales -->
<div class="mt-8 flex flex-wrap items-center gap-3 justify-center lg:justify-start">

  <!-- Botón LinkedIn -->
  <a
    href="https://www.linkedin.com/in/juan-sebastian-gil-coy-4b6ba7372/"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-blue-500
           bg-white text-blue-600 font-medium text-sm shadow-sm
           hover:bg-blue-50 active:scale-[0.98]
           dark:bg-transparent dark:text-blue-400 dark:border-blue-400 dark:hover:bg-blue-400/10
           transition-all duration-300"
  >
    <!-- Icono LinkedIn -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="h-5 w-5"
    >
      <path d="M19 0h-14C2.2 0 1 1.2 1 2.7v18.6C1 22.8 2.2 24 3.7 24h14.6c1.5 0 2.7-1.2 2.7-2.7V2.7C21.4 1.2 20.2 0 18.7 0zM7.2 20.4H4.4V9.3h2.8v11.1zM5.8 7.9c-.9 0-1.6-.7-1.6-1.6S4.9 4.7 5.8 4.7s1.6.7 1.6 1.6-.7 1.6-1.6 1.6zM20 20.4h-2.8v-6c0-1.4-.5-2.3-1.6-2.3-.9 0-1.4.6-1.7 1.3-.1.2-.1.6-.1.9v6.1H10v-11h2.7v1.5c.4-.6 1.2-1.7 2.9-1.7 2.1 0 3.6 1.4 3.6 4.3v6.9z"/>
    </svg>
    <span>LinkedIn</span>
  </a>

  <!-- Botón GitHub -->
  <a
    href="https://github.com/SebasGil-Dev"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-neutral-700
           bg-white text-neutral-800 font-medium text-sm shadow-sm
           hover:bg-neutral-50 active:scale-[0.98]
           dark:bg-transparent dark:text-white dark:border-neutral-400 dark:hover:bg-neutral-800/60
           transition-all duration-300"
  >
    <!-- Icono GitHub -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="h-5 w-5"
    >
      <path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.38 7.86 10.9.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.53-1.35-1.29-1.7-1.29-1.7-1.06-.73.08-.72.08-.72 1.18.08 1.8 1.23 1.8 1.23 1.04 1.78 2.73 1.27 3.4.97.11-.77.41-1.27.75-1.56-2.56-.29-5.26-1.28-5.26-5.68 0-1.25.45-2.27 1.2-3.07-.12-.29-.52-1.47.11-3.06 0 0 .98-.31 3.2 1.17.93-.26 1.93-.39 2.93-.39s2 .13 2.93.39c2.22-1.48 3.2-1.17 3.2-1.17.63 1.59.23 2.77.11 3.06.75.8 1.2 1.82 1.2 3.07 0 4.42-2.71 5.38-5.29 5.66.42.36.81 1.08.81 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/>
    </svg>
    <span>GitHub</span>
  </a>

</div>

    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
  summary::marker { content: ""; }
</style>

<script is:inline>
  // Cierra el menú si haces clic fuera o presionas ESC
  document.addEventListener('click', (e) => {
    const open = document.querySelector('details[data-cv-menu][open]');
    if (!open) return;
    if (!open.contains(e.target)) open.removeAttribute('open');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll('details[data-cv-menu][open]')
      .forEach(d => d.removeAttribute('open'));
  });
</script>
