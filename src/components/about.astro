---
/* sin props por ahora */
---

<section
  id="sobre-mi"
  class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-16"
  aria-label="Presentación"
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">


<!-- Columna izquierda: imagen con blob -->
<div class="relative mx-auto lg:mx-0 w-[min(520px,90vw)] aspect-square flex items-center justify-center">
  <!-- Blob decorativo -->
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-br from-lime-300 via-yellow-300 to-amber-300
           rounded-full blur-3xl opacity-70 dark:opacity-30"
  ></div>

  <!-- Imagen redonda centrada -->
  <img
    src="/profile.png"
    alt="Sebastián Gil"
    class="relative z-10 h-[80%] w-[80%] object-cover rounded-full ring-4 ring-white/30 dark:ring-neutral-800/60
           shadow-2xl transition-transform duration-500 ease-out hover:scale-103"
    loading="eager"
    decoding="async"
  />

  <!-- Botón: Disponible para trabajar (superpuesto al borde inferior de la imagen) -->
  <a
    href="#contacto"
    aria-label="Ir a contacto"
    class="group absolute left-1/2 -translate-x-1/2 bottom-[8%]  <!-- ajusta este valor para moverlo -->
           inline-flex items-center transition md:hover:scale-105 z-20"
  >
    <span class="relative inline-flex overflow-hidden rounded-full p-[1px]">
      <!-- borde animado -->
      <span
        class="absolute inset-[-1000%] animate-[spin_2s_linear_infinite]
               bg-[conic-gradient(from_90deg_at_50%_50%,#15EAAB_0%,#2154E5_50%,#15EAAB_100%)]"
        aria-hidden="true"
      ></span>

      <!-- cuerpo del botón -->
      <div
        class="inline-flex items-center justify-center w-full px-3 py-1 text-sm
               text-green-800 bg-green-100 rounded-full cursor-pointer
               dark:bg-gray-800 dark:text-white/80 backdrop-blur-3xl whitespace-nowrap"
      >
        Disponible para trabajar
      </div>
    </span>
  </a>
</div>




    <!-- Columna derecha: texto y CTAs -->
    <div class="text-center lg:text-left">
      <h1
        class="flex flex-wrap justify-center lg:justify-start items-baseline
              gap-2 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight"
      >
        <span data-i18n="about_greeting">Hola, soy</span>
        <span
          class="bg-gradient-to-r from-lime-600 via-lime-500 to-amber-500
                bg-clip-text text-transparent whitespace-nowrap"
          data-i18n="about_titles"
        >
          Programador
        </span>
      </h1>


      <p
        class="mt-5 text-base sm:text-[17px] leading-relaxed text-neutral-700 dark:text-neutral-300 max-w-2xl mx-auto lg:mx-0"
        data-i18n="about_description"
      >
        Como estudiante de Ingeniería de Sistemas y Computación, mi camino ha estado marcado por la curiosidad…
      </p>

      <!-- CTAs -->
      <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 sm:gap-5 justify-center lg:justify-start">

        <!-- Botón Descargar CV -->
        <a
          href="/cv-es.pdf"
          class="inline-flex items-center justify-center rounded-full px-6 py-3
                 text-white bg-blue-600 hover:bg-blue-700 active:scale-95
                 shadow-lg shadow-blue-600/25 transition"
        >
          <span class="font-semibold" data-i18n="about_cv">Descargar CV</span>
          <span aria-hidden="true" class="ml-2">⬇</span>
        </a>

        <!-- “Chip” de email (estático por ahora) -->
        <div
          class="inline-flex items-center rounded-full border border-black/10 dark:border-white/15
                 bg-white/80 dark:bg-neutral-900/70 backdrop-blur-sm
                 px-4 py-2.5 text-sm text-neutral-700 dark:text-neutral-200
                 ring-1 ring-black/5 dark:ring-white/5 shadow-sm"
        >
          <svg class="mr-2 h-5 w-5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M4 6h16a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M22 8l-10 6L2 8"/>
          </svg>
          <span>sebastiangildev@gmail.com</span>
        </div>
      </div>

      <!-- Social -->
      <div class="mt-8 flex items-center gap-4 justify-center lg:justify-start">
        <a href="https://github.com/SebasGil-Dev" class="group inline-flex h-11 w-11 items-center justify-center rounded-full
               border border-black/10 dark:border-white/15 bg-white/70 dark:bg-neutral-900/70 backdrop-blur
               ring-1 ring-black/5 dark:ring-white/5 hover:scale-105 active:scale-95 transition">
          <svg class="h-6 w-6 text-neutral-800 dark:text-neutral-200 group-hover:opacity-90" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.38 7.86 10.9.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.53-1.35-1.29-1.7-1.29-1.7-1.06-.73.08-.72.08-.72 1.18.08 1.8 1.23 1.8 1.23 1.04 1.78 2.73 1.27 3.4.97.11-.77.41-1.27.75-1.56-2.56-.29-5.26-1.28-5.26-5.68 0-1.25.45-2.27 1.2-3.07-.12-.29-.52-1.47.11-3.06 0 0 .98-.31 3.2 1.17.93-.26 1.93-.39 2.93-.39s2 .13 2.93.39c2.22-1.48 3.2-1.17 3.2-1.17.63 1.59.23 2.77.11 3.06.75.8 1.2 1.82 1.2 3.07 0 4.42-2.71 5.38-5.29 5.66.42.36.81 1.08.81 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/>
          </svg>
          <span class="sr-only">GitHub</span>
        </a>

        <a href="https://www.linkedin.com/in/tu-perfil" class="group inline-flex h-11 w-11 items-center justify-center rounded-full
               border border-black/10 dark:border-white/15 bg-white/70 dark:bg-neutral-900/70 backdrop-blur
               ring-1 ring-black/5 dark:ring-white/5 hover:scale-105 active:scale-95 transition">
          <svg class="h-6 w-6 text-neutral-800 dark:text-neutral-200 group-hover:opacity-90" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 0h-14C2.2 0 1 1.2 1 2.7v18.6C1 22.8 2.2 24 3.7 24h14.6c1.5 0 2.7-1.2 2.7-2.7V2.7C21.4 1.2 20.2 0 18.7 0zM7.2 20.4H4.4V9.3h2.8v11.1zM5.8 7.9c-.9 0-1.6-.7-1.6-1.6S4.9 4.7 5.8 4.7s1.6.7 1.6 1.6-.7 1.6-1.6 1.6zM20 20.4h-2.8v-6c0-1.4-.5-2.3-1.6-2.3-.9 0-1.4.6-1.7 1.3-.1.2-.1.6-.1.9v6.1H10v-11h2.7v1.5c.4-.6 1.2-1.7 2.9-1.7 2.1 0 3.6 1.4 3.6 4.3v6.9z"/>
          </svg>
          <span class="sr-only">LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</section>
