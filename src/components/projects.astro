---
/**
 * IMÁGENES en /public/projects/ (ej.: /projects/astro.webp)
 * ICONOS en src/assets/skills/*.svg
 */
import htmlIcon from "../assets/skills/html.svg";
import cssIcon from "../assets/skills/css.svg";
import jsIcon from "../assets/skills/javascript.svg";
import tsIcon from "../assets/skills/typescript.svg";
import astroIcon from "../assets/skills/astro.svg";
import nodeIcon from "../assets/skills/nodejs.svg";
import sqlIcon from "../assets/skills/sql.svg";
import javaIcon from "../assets/skills/java.svg";
import cppIcon from "../assets/skills/cpp.svg";
import pythonIcon from "../assets/skills/python.svg";

const techIcons: Record<string, any> = {
  HTML: htmlIcon,
  CSS: cssIcon,
  "CSS / Tailwind": cssIcon, // cámbialo si tienes tailwind.svg
  Tailwind: cssIcon,
  JavaScript: jsIcon,
  TypeScript: tsIcon,
  Astro: astroIcon,
  "Node.js": nodeIcon,
  SQL: sqlIcon,
  Java: javaIcon,
  "C++": cppIcon,
  Python: pythonIcon,
};

const projects = [
  {
    titleKey: "project_astro_title",
    title: "Astro",
    descKey: "project_astro_desc",
    desc: "Sitio web construido con Astro y diseño responsivo.",
    img: "/projects/astro.webp",
    github: "https://github.com/usuario/proyecto-astro",
    tech: ["Astro", "Tailwind", "TypeScript"],
  },
  {
    titleKey: "project_sql_title",
    title: "SQL",
    descKey: "project_sql_desc",
    desc: "Simulador de base de datos con consultas interactivas.",
    img: "/projects/sql.jpeg",
    github: "https://github.com/usuario/proyecto-sql",
    tech: ["SQL", "Node.js", "JavaScript"],
  },
  {
    titleKey: "project_java_title",
    title: "Java",
    descKey: "project_java_desc",
    desc: "Juego de pétalos animados con acceso por código.",
    img: "/projects/java.webp",
    github: "https://github.com/usuario/proyecto-java",
    tech: ["Java"],
  },
];
---

<h2
  class="text-4xl sm:text-5xl font-extrabold tracking-tight
         leading-[1.15] pb-2 text-center
         bg-gradient-to-r from-lime-600 via-lime-500 to-amber-500
         bg-clip-text text-transparent"
  data-i18n="projects_title"
>
  Proyectos
</h2>




  <!-- Wrapper para posicionar flechas -->
  <div class="relative max-w-7xl mx-auto">
    <!-- Flechas (solo icono) -->
    <button
      type="button" aria-label="Anterior" data-prev
      class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 z-30
             text-red-500 hover:text-red-600 dark:text-red-400 dark:hover:text-red-300
             transition-colors"
    >
      <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>

    <button
      type="button" aria-label="Siguiente" data-next
      class="absolute right-3 sm:right-4 top-1/2 -translate-y-1/2 z-30
             text-red-500 hover:text-red-600 dark:text-red-400 dark:hover:text-red-300
             transition-colors"
    >
      <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </button>

    <!-- Track: una card a la vez, con “peek” a los lados -->
    <div
      id="projects-track"
      class="relative snap-x snap-mandatory [scroll-snap-stop:always]
             overflow-x-auto overflow-y-visible scroll-smooth
             flex gap-10 px-12 sm:px-16 lg:px-24
             [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {projects.map((p, idx) => (
        <article
          data-index={idx}
          data-active={idx === 0 ? "true" : "false"}
          class="snap-center shrink-0 w-[85vw] max-w-5xl mx-auto transition-all duration-500
                 [transform-origin:center]
                 data-[active=false]:opacity-50
                 data-[active=false]:scale-[.94]
                 data-[active=false]:blur-[2px]
                 data-[active=true]:opacity-100
                 data-[active=true]:scale-100
                 data-[active=true]:blur-0"
        >
          <!-- Card -->
          <div
            class="relative flex flex-col lg:flex-row items-stretch
                   rounded-3xl border border-black/10 dark:border-white/10
                   bg-white/70 dark:bg-neutral-900/60 backdrop-blur
                   shadow-lg ring-1 ring-black/5 dark:ring-white/5 overflow-hidden"
          >
            <!-- IMG (60%) -->
            <div class="lg:basis-3/5">
              <img
                src={p.img}
                alt={p.title}
                class="h-full w-full object-cover lg:aspect-[16/9] aspect-[16/9]"
                loading="lazy"
                decoding="async"
              />
            </div>

            <!-- INFO (40%) -->
            <div class="lg:basis-2/5 p-6 sm:p-8 flex flex-col gap-4">
              <h3 class="text-2xl font-semibold text-neutral-900 dark:text-white" data-i18n={p.titleKey}>
                {p.title}
              </h3>

              <p class="text-neutral-700 dark:text-neutral-300 text-sm sm:text-base" data-i18n={p.descKey}>
                {p.desc}
              </p>

              <!-- Tecnologías con iconos -->
              <div>
                <p class="text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-2" data-i18n="projects_tech_label">
                  Tecnologías
                </p>
                <ul class="flex flex-wrap gap-2">
                  {p.tech.map((t) => {
                    const icon = techIcons[t];
                    return (
                      <li
                        class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium
                               border border-black/10 dark:border-white/10
                               bg-white/70 dark:bg-neutral-800/70
                               text-neutral-800 dark:text-neutral-200"
                      >
                        {icon ? (
                          <img src={icon.src} alt={t} class="h-4 w-4 object-contain invert dark:invert-0" loading="lazy" decoding="async" />
                        ) : null}
                        <span>{t}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>

              <!-- CTA GitHub -->
              <div class="mt-2">
                <a
                  href={p.github} target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-gray-300
                         bg-white text-gray-800 font-medium text-sm shadow-sm
                         hover:bg-gray-100 active:scale-[0.98]
                         dark:bg-neutral-900 dark:text-white dark:border-neutral-700 dark:hover:bg-neutral-800
                         transition-all duration-300 group"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                       fill="currentColor"
                       class="w-5 h-5 text-gray-900 dark:text-white transition-transform group-hover:scale-110">
                    <path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.38 7.86 10.9.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.53-1.35-1.29-1.7-1.29-1.7-1.06-.73.08-.72.08-.72 1.18.08 1.8 1.23 1.8 1.23 1.04 1.78 2.73 1.27 3.4.97.11-.77.41-1.27.75-1.56-2.56-.29-5.26-1.28-5.26-5.68 0-1.25.45-2.27 1.2-3.07-.12-.29-.52-1.47.11-3.06 0 0 .98-.31 3.2 1.17.93-.26 1.93-.39 2.93-.39s2 .13 2.93.39c2.22-1.48 3.2-1.17 3.2-1.17.63 1.59.23 2.77.11 3.06.75.8 1.2 1.82 1.2 3.07 0 4.42-2.71 5.38-5.29 5.66.42.36.81 1.08.81 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/>
                  </svg>
                  <span data-i18n="projects_github_label">Ver en GitHub</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  // --- Carousel circular con “peeking” y card activa ---

  const track = document.getElementById('projects-track');
  if (!track) { console.warn('Carousel: track no encontrado'); }
  else {
    // Tarjetas reales (sin clones)
    let realCards = Array.from(track.querySelectorAll('article[data-index]'));
    if (realCards.length < 2) {
      // Con 1 sola card no tiene sentido el loop
      realCards.forEach(el => el.dataset.active = 'true');
    } else {
      const firstReal = realCards[0];
      const lastReal  = realCards[realCards.length - 1];

      // Clonar extremos para looping infinito
      const cloneFirst = firstReal.cloneNode(true);
      cloneFirst.dataset.clone = 'true';
      cloneFirst.dataset.cloneType = 'first';

      const cloneLast = lastReal.cloneNode(true);
      cloneLast.dataset.clone = 'true';
      cloneLast.dataset.cloneType = 'last';

      // Insertamos clones
      track.insertBefore(cloneLast, firstReal);
      track.appendChild(cloneFirst);

      // Todas las cards (reales + clones)
      const allCards = Array.from(track.querySelectorAll('article[data-index]'));

      const scrollToCard = (el, smooth = false) => {
        el.scrollIntoView({ behavior: smooth ? 'smooth' : 'instant', inline: 'center', block: 'nearest' });
      };

      // Posicionamos al inicio real (hay clon antes)
      scrollToCard(firstReal, false);

      // Marcar activa la card más centrada
      function setActiveByCenter() {
        const viewportCenter = window.innerWidth / 2;
        let best = { el: null, dist: Infinity };
        allCards.forEach(el => {
          const rect = el.getBoundingClientRect();
          const cardCenter = rect.left + rect.width / 2;
          const dist = Math.abs(cardCenter - viewportCenter);
          if (dist < best.dist) best = { el, dist };
        });

        allCards.forEach(el => el.dataset.active = (el === best.el) ? 'true' : 'false');

        // Si caímos en un clon, saltamos inmediatamente a su real correspondiente
        if (best.el?.dataset.clone === 'true') {
          const type = best.el.dataset.cloneType;
          requestAnimationFrame(() => {
            if (type === 'last') scrollToCard(lastReal, false);
            if (type === 'first') scrollToCard(firstReal, false);
          });
        }
      }

      const onScroll = () => requestAnimationFrame(setActiveByCenter);
      setActiveByCenter();
      track.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });

      // Navegación por flechas: paso = ancho de una card + gap
      const prev = document.querySelector('[data-prev]');
      const next = document.querySelector('[data-next]');

      const measureStep = () => {
        const card = firstReal;
        if (!card) return track.clientWidth;
        const rect = card.getBoundingClientRect();
        const styles = getComputedStyle(track);
        const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
        return rect.width + gap;
      };
      const step = () => measureStep();

      prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      next?.addEventListener('click', () => track.scrollBy({ left:  step(), behavior: 'smooth' }));

      // Accesibilidad: teclado
      track.setAttribute('tabindex', '0');
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft')  prev?.click();
        if (e.key === 'ArrowRight') next?.click();
      });
    }
  }
</script>
