---
// src/components/Contact.astro

const EMAIL = "sebastiangildev@gmail.com";
const LINKEDIN = "https://www.linkedin.com/in/juan-sebastian-gil-coy-4b6ba7372/";
const GITHUB = "https://github.com/SebasGil-Dev";
const WHATSAPP_URL = "https://wa.me/573123111372?text=Hola%20Juan%20Sebasti%C3%A1n%2C%20vi%20tu%20portafolio";
const WHATSAPP_TXT = "+57 312 311 1372";
---

<section
  id="contacto"
  class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20"
  aria-label="Contacto"
>
  <!-- Header -->
  <div class="text-center mb-14">
    <h2
      class="text-4xl sm:text-5xl font-extrabold tracking-tight
         text-black dark:text-white mb-3"
      data-i18n="contact_title"
    >
      Contacto
    </h2>

    <p
      class="text-neutral-600 dark:text-neutral-400 text-base sm:text-lg max-w-2xl mx-auto"
      data-i18n="contact_subtitle"
    >
      ¿Tienes un proyecto o idea? Hablemos.
    </p>
  </div>

  <!-- Grid -->
  <div class="grid gap-4 sm:gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Email -->
    <a
      href={`mailto:${EMAIL}`}
      class="group relative rounded-2xl border border-white/10 bg-white/5 backdrop-blur
             p-5 sm:p-6 flex items-start gap-4 transition
             hover:border-white/20 hover:bg-white/10 focus:outline-none
             focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white/40
             transform hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/5
             dark:hover:shadow-black/20"
      aria-label="Email"
    >
      <div
        class="shrink-0 rounded-xl p-3 border border-white/10 bg-white/10
               transition group-hover:bg-white/20 group-hover:border-white/20"
        aria-hidden="true"
      >
        <!-- Email (stroke, nítido) -->
        <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="5" width="18" height="14" rx="2" ry="2"></rect>
          <path d="M3 7l9 6 9-6"></path>
        </svg>
      </div>
      <div class="min-w-0">
        <h3 class="font-medium text-base" data-i18n="contact_email">Correo</h3>
        <p class="text-sm opacity-80 truncate">{EMAIL}</p>
      </div>
    </a>

    <!-- LinkedIn -->
    <a
      href={LINKEDIN}
      target="_blank"
      rel="noopener noreferrer"
      class="group relative rounded-2xl border border-white/10 bg-white/5 backdrop-blur
             p-5 sm:p-6 flex items-start gap-4 transition
             hover:border-white/20 hover:bg-white/10 focus:outline-none
             focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white/40
             transform hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/5
             dark:hover:shadow-black/20"
      aria-label="LinkedIn"
    >
      <div
        class="shrink-0 rounded-xl p-3 border border-white/10 bg-white/10
               transition group-hover:bg-white/20 group-hover:border-white/20"
        aria-hidden="true"
      >
        <!-- LinkedIn (stroke limpio, estilo lucide) -->
        <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4v2a4 4 0 0 1 4-2Z"></path>
          <rect x="2" y="8" width="4" height="13" rx="1"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </div>
      <div class="min-w-0">
        <h3 class="font-medium text-base" data-i18n="contact_linkedin">LinkedIn</h3>
        <p class="text-sm opacity-80 truncate">juan-sebastian-gil-coy</p>
      </div>
    </a>

    <!-- GitHub (igual) -->
    <a
      href={GITHUB}
      target="_blank"
      rel="noopener noreferrer"
      class="group relative rounded-2xl border border-white/10 bg-white/5 backdrop-blur
             p-5 sm:p-6 flex items-start gap-4 transition
             hover:border-white/20 hover:bg-white/10 focus:outline-none
             focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white/40
             transform hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/5
             dark:hover:shadow-black/20"
      aria-label="GitHub"
    >
      <div
        class="shrink-0 rounded-xl p-3 border border-white/10 bg-white/10
               transition group-hover:bg-white/20 group-hover:border-white/20"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" class="w-6 h-6 fill-current">
          <path d="M12 .7a11.3 11.3 0 0 0-3.57 22c.56.1.76-.24.76-.54V20.3c-3.1.68-3.76-1.34-3.76-1.34-.5-1.26-1.22-1.6-1.22-1.6-.99-.68.07-.66.07-.66 1.1.08 1.67 1.14 1.67 1.14.98 1.67 2.58 1.19 3.21.91.1-.73.38-1.19.69-1.47-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.16-3-.12-.28-.5-1.41.11-2.95 0 0 .96-.31 3.15 1.15a10.9 10.9 0 0 1 5.74 0c2.2-1.46 3.15-1.15 3.15-1.15.61 1.54.24 2.67.12 2.95.72.78 1.15 1.78 1.15 3 0 4.3-2.61 5.25-5.1 5.52.39.34.73 1.01.73 2.04v3.02c0 .3.2.65.77.54A11.3 11.3 0 0 0 12 .7Z" />
        </svg>
      </div>
      <div class="min-w-0">
        <h3 class="font-medium text-base" data-i18n="contact_github">GitHub</h3>
        <p class="text-sm opacity-80 truncate">SebasGil-Dev</p>
      </div>
    </a>

    <!-- WhatsApp -->
    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="group relative rounded-2xl border border-white/10 bg-white/5 backdrop-blur
             p-5 sm:p-6 flex items-start gap-4 transition
             hover:border-white/20 hover:bg-white/10 focus:outline-none
             focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white/40
             transform hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/5
             dark:hover:shadow-black/20"
      aria-label="WhatsApp"
    >
      <div
        class="shrink-0 rounded-xl p-3 border border-white/10 bg-white/10
               transition group-hover:bg-white/20 group-hover:border-white/20"
        aria-hidden="true"
      >
        <!-- WhatsApp (stroke claro) -->
<!-- WhatsApp (relleno sólido, centrado y claro) -->
        <svg viewBox="0 0 24 24" class="w-6 h-6 fill-current">
          <path d="M20.52 3.48A11.86 11.86 0 0 0 12 0 12 12 0 0 0 0 12a11.86 11.86 0 0 0 3.48 8.52L2 24l3.6-1.44A11.86 11.86 0 0 0 12 24a12 12 0 0 0 12-12c0-3.2-1.25-6.21-3.48-8.52ZM12 22a9.94 9.94 0 0 1-5.13-1.44l-.37-.21-2.14.85.43-2.07-.26-.38A9.94 9.94 0 0 1 2 12C2 6.48 6.48 2 12 2s10 4.48 10 10-4.48 10-10 10Zm5.28-7.06c-.29-.14-1.71-.84-1.97-.93-.26-.1-.45-.14-.64.14-.19.29-.74.93-.91 1.12-.17.19-.34.22-.63.07a8.12 8.12 0 0 1-2.4-1.48 9.1 9.1 0 0 1-1.69-2.1c-.18-.29 0-.45.13-.6.13-.13.29-.34.43-.51.14-.17.19-.29.29-.48.1-.19.05-.36-.02-.5-.07-.14-.64-1.54-.88-2.11-.23-.56-.47-.49-.64-.5h-.55c-.18 0-.48.07-.73.36s-.96.94-.96 2.3.99 2.67 1.13 2.85c.14.19 1.94 2.95 4.73 4.14.66.28 1.18.45 1.58.58.66.21 1.26.18 1.73.11.53-.08 1.71-.7 1.95-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.19-.55-.33Z"/>
        </svg>

      </div>
      <div class="min-w-0">
        <h3 class="font-medium text-base" data-i18n="contact_whatsapp">WhatsApp</h3>
        <p class="text-sm opacity-80 truncate">{WHATSAPP_TXT}</p>
      </div>
    </a>
  </div>
</section>
