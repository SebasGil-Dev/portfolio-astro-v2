---
/* Netlify Forms (AJAX) + i18n con placeholders */
---

<section id="contacto" class="relative max-w-[100vw] py-20 overflow-visible" aria-label="Contacto">
  <!-- Halo suave -->
  <div aria-hidden="true"
       class="pointer-events-none absolute -z-10 inset-x-0 top-1/3 h-[420px]
              bg-gradient-to-b from-cyan-200/25 via-lime-200/20 to-transparent
              dark:from-cyan-400/10 dark:via-lime-300/10 blur-[60px]"></div>

  <div class="px-4 sm:px-6 lg:px-8 mb-10 text-center">
    <h2
      class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.15] pb-2 text-center
             bg-gradient-to-r from-lime-600 via-lime-500 to-amber-500
             bg-clip-text text-transparent"
      data-i18n="contact_title"
    >Contacto</h2>

    <p class="mt-4 max-w-2xl text-base sm:text-lg text-neutral-700 dark:text-neutral-300 mx-auto"
       data-i18n="contact_subtitle">
      ¿Tienes un proyecto en mente o quieres saludar? Escríbeme y te respondo.
    </p>
  </div>

  <!-- Card: alterna entre Form y Gracias -->
  <div class="max-w-3xl mx-auto">
    <!-- FORM (Netlify + honeypot) -->
    <form
      id="contactForm"
      name="contacto"
      method="POST"
      data-netlify="true"
      netlify-honeypot="company"
      class="rounded-3xl border border-black/10 dark:border-white/10
             bg-white/70 dark:bg-neutral-900/60 backdrop-blur
             ring-1 ring-black/5 dark:ring-white/5 shadow-lg p-6 sm:p-8 grid gap-4"
    >
      <!-- Requerido por Netlify -->
      <input type="hidden" name="form-name" value="contacto" />
      <!-- Honeypot -->
      <p class="hidden">
        <label>Don’t fill this out: <input name="company" /></label>
      </p>

      <div class="grid sm:grid-cols-2 gap-4">
        <label class="grid gap-2">
          <span class="text-sm text-neutral-600 dark:text-neutral-300" data-i18n="contact_name_label">Nombre</span>
          <input
            type="text" name="name" required minlength="2" autocomplete="name"
            placeholder="Tu nombre"
            class="rounded-xl border border-black/10 dark:border-white/10
                   bg-white/70 dark:bg-neutral-800/70 text-neutral-900 dark:text-white
                   px-4 py-3 ring-1 ring-black/5 dark:ring-white/5 outline-none
                   focus:border-blue-400 focus:ring-blue-200 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/20"
            data-i18n-placeholder="contact_name_ph"
          />
        </label>

        <label class="grid gap-2">
          <span class="text-sm text-neutral-600 dark:text-neutral-300" data-i18n="contact_email_label">Email</span>
          <input
            type="email" name="email" required autocomplete="email"
            placeholder="tu@email.com"
            class="rounded-xl border border-black/10 dark:border-white/10
                   bg-white/70 dark:bg-neutral-800/70 text-neutral-900 dark:text-white
                   px-4 py-3 ring-1 ring-black/5 dark:ring-white/5 outline-none
                   focus:border-blue-400 focus:ring-blue-200 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/20"
            data-i18n-placeholder="contact_email_ph"
          />
        </label>
      </div>

      <label class="grid gap-2">
        <span class="text-sm text-neutral-600 dark:text-neutral-300" data-i18n="contact_message_label">Mensaje</span>
        <textarea
          name="message" required rows={6} minlength="10"
          placeholder="Cuéntame brevemente tu idea…"
          class="rounded-xl border border-black/10 dark:border-white/10
                 bg-white/70 dark:bg-neutral-800/70 text-neutral-900 dark:text-white
                 px-4 py-3 ring-1 ring-black/5 dark:ring-white/5 outline-none
                 focus:border-blue-400 focus:ring-blue-200 dark:focus:border-cyan-400 dark:focus:ring-cyan-400/20"
          data-i18n-placeholder="contact_message_ph"
        ></textarea>
      </label>

      <!-- reCAPTCHA opcional -->
      <!-- <div data-netlify-recaptcha="true" class="mt-2"></div> -->

      <div class="flex items-center justify-between gap-4 mt-2">
        <p class="text-xs text-neutral-500 dark:text-neutral-400" data-i18n="contact_privacy">
          Enviarás tus datos de forma segura. Nunca comparto tu información.
        </p>
        <button
          type="submit" id="sendBtn"
          class="inline-flex items-center gap-2 rounded-full border border-gray-300
                 bg-white text-gray-800 font-medium text-sm px-5 py-2 shadow-sm
                 hover:bg-gray-100 active:scale-[0.98]
                 dark:bg-neutral-900 dark:text-white dark:border-neutral-700 dark:hover:bg-neutral-800
                 transition-all duration-300"
        >
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
          <span data-i18n="contact_send">Enviar</span>
        </button>
      </div>

      <!-- Error (oculto) -->
      <p id="contactError" class="hidden text-sm text-red-600 dark:text-red-400 mt-2" data-i18n="contact_error">
        Hubo un problema al enviar. Intenta de nuevo.
      </p>
    </form>

    <!-- GRACIAS (oculto) -->
    <div
      id="contactThanks"
      class="hidden rounded-3xl border border-black/10 dark:border-white/10
             bg-white/70 dark:bg-neutral-900/60 backdrop-blur
             ring-1 ring-black/5 dark:ring-white/5 shadow-lg p-8 text-center"
    >
      <h3
        class="text-2xl font-semibold
               bg-gradient-to-r from-lime-600 via-lime-500 to-amber-500
               bg-clip-text text-transparent mb-2"
        data-i18n="contact_thanks_title"
      >¡Gracias por tu mensaje!</h3>

      <p class="text-neutral-700 dark:text-neutral-300 max-w-xl mx-auto" data-i18n="contact_thanks_body">
        Te responderé lo antes posible. Si necesitas algo urgente, también puedes escribirme por correo.
      </p>

      <button
        type="button" id="contactReset"
        class="mt-6 inline-flex items-center gap-2 rounded-full border border-gray-300
               bg-white text-gray-800 font-medium text-sm px-5 py-2 shadow-sm
               hover:bg-gray-100 active:scale-[0.98]
               dark:bg-neutral-900 dark:text-white dark:border-neutral-700 dark:hover:bg-neutral-800
               transition-all duration-300"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v6h6M20 20v-6h-6M20 10a8 8 0 10-8 8"/>
        </svg>
        <span data-i18n="contact_thanks_again">Enviar otro mensaje</span>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  // Envío AJAX a Netlify (sin redirección)
  const form     = document.getElementById('contactForm');
  const btn      = document.getElementById('sendBtn');
  const err      = document.getElementById('contactError');
  const thanks   = document.getElementById('contactThanks');
  const resetBtn = document.getElementById('contactReset');

  function encode(data) { return new URLSearchParams(data).toString(); }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Honeypot
    const hp = form.querySelector('input[name="company"]');
    if (hp && hp.value.trim() !== '') return;

    btn?.setAttribute('disabled','true');
    btn?.classList.add('opacity-70','cursor-not-allowed');

    const data = new FormData(form);
    data.append('form-name', form.getAttribute('name') || 'contacto');

    try {
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: encode(Object.fromEntries(data)),
      });

      if (res.ok) {
        form.classList.add('hidden');
        thanks?.classList.remove('hidden');
        err?.classList.add('hidden');
      } else {
        throw new Error('Netlify error');
      }
    } catch {
      err?.classList.remove('hidden');
    } finally {
      btn?.removeAttribute('disabled');
      btn?.classList.remove('opacity-70','cursor-not-allowed');
      form.reset();
    }
  });

  resetBtn?.addEventListener('click', () => {
    thanks?.classList.add('hidden');
    form?.classList.remove('hidden');
  });
</script>
