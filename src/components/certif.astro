---
const CERTS = [
  {
    id: "cert-routing",
    title: "Routing Básico - 2da edición 2023",
    issuer: "Lacnic Campus",
    year: "2023",
    pdf: "/certs/Routing_Basico.pdf",
    thumb: "/certs/thumbs/Routing_Basico.jpg",
  },
  {
    id: "cert-data-analytics-python",
    title: "Data Analytics with Python",
    issuer: "Simplilearn (via Coursera)",
    year: "2026",
    pdf: "/certs/Data_Analytics.pdf",
    thumb: "/certs/thumbs/Data_Analytics.jpg",
  },
  {
    id: "cert-sql-python",
    title: "Databases and SQL for Data Science with Python",
    issuer: "IBM (via Coursera)",
    year: "2026",
    pdf: "/certs/Database and SQL for datacience whith pyhon.pdf",
    thumb: "/certs/thumbs/IBM.Png",
  },
];
---

<section
  id="certificados"
  class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-16"
  aria-label="Certificados"
>
  <!-- Título -->
  <div class="text-center mb-10">
    <h2
      class="text-4xl sm:text-5xl font-extrabold tracking-tight
            text-black dark:text-white mb-3"
      data-i18n="certs_title"
    >
      Certificados
    </h2>
    <p
      class="mt-3 text-neutral-600 dark:text-neutral-300"
      data-i18n="certs_subtitle"
    >
      Visualización de certificados obtenidos.
    </p>
  </div>

  <!-- Grid de 3 columnas -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {CERTS.map((c) => (
      <article
        class="group rounded-2xl border border-black/10 dark:border-white/10
               bg-white/70 dark:bg-neutral-900/70 ring-1 ring-black/5 dark:ring-white/5
               shadow-sm hover:shadow-lg transition overflow-hidden"
      >
        <button
          type="button"
          class="w-full text-left"
          data-open-modal={c.id}
          aria-haspopup="dialog"
          aria-controls={`modal-${c.id}`}
          aria-label={`Abrir certificado ${c.title}`}
        >
          <div class="aspect-[4/3] bg-neutral-100 dark:bg-neutral-800 overflow-hidden">
            {c.thumb ? (
              <img
                src={c.thumb}
                alt={c.title}
                class="h-full w-full object-cover group-hover:scale-[1.02] transition"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="h-full w-full flex items-center justify-center text-neutral-400">
                PDF
              </div>
            )}
          </div>

          <div class="p-4">
            <h3 class="text-lg font-semibold">{c.title}</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">
              {c.issuer} • {c.year}
            </p>
          </div>
        </button>
      </article>
    ))}
  </div>

  <p
    class="mt-6 text-center text-xs text-neutral-500 dark:text-neutral-400"
    data-i18n="certs_note"
  >

  </p>

  <!-- Modales -->
  {CERTS.map((c) => (
    <div
      id={`modal-${c.id}`}
      role="dialog"
      aria-modal="true"
      aria-labelledby={`modal-title-${c.id}`}
      class="fixed inset-0 z-50 hidden"
      data-modal
    >
      <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" data-close-modal></div>

      <div class="absolute inset-0 flex items-center justify-center p-4">
        <div
          class="relative w-full max-w-6xl bg-white dark:bg-neutral-900 rounded-2xl shadow-xl overflow-hidden"
        >
          <header
            class="flex items-center justify-between px-4 py-3 border-b border-black/10 dark:border-white/10"
          >
            <h2 id={`modal-title-${c.id}`} class="text-lg font-semibold">
              {c.title}
            </h2>
            <button
              type="button"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full
                     hover:bg-black/5 dark:hover:bg-white/10 transition"
              aria-label="Cerrar"
              data-close-modal
            >
              ✕
            </button>
          </header>

          <div class="relative">
            <object
              data={c.pdf}
              type="application/pdf"
              class="w-full h-[75vh] bg-neutral-100 dark:bg-neutral-800"
            >
              <div class="p-4 text-center">
                <p class="text-sm mb-2">No se pudo mostrar el PDF embebido.</p>
                <a
                  href={c.pdf}
                  target="_blank"
                  rel="noopener"
                  class="underline"
                >
                  Abrir en nueva pestaña
                </a>
              </div>
            </object>
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- JS: abre/cierra modales -->
  <script is:inline>
    const openers = document.querySelectorAll("[data-open-modal]");
    const modals = document.querySelectorAll("[data-modal]");

    openers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-open-modal");
        const modal = document.getElementById(`modal-${id}`);
        if (modal) modal.classList.remove("hidden");
      });
    });

    modals.forEach((modal) => {
      modal.addEventListener("click", (e) => {
        const target = e.target;
        if (target?.hasAttribute("data-close-modal") || target === modal)
          modal.classList.add("hidden");
      });
    });
  </script>
</section>
