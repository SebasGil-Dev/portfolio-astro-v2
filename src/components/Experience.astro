---
const JOBS = [
  {
    id: "banco-bogota",
    company: "Banco de Bogotá",
    role_es: "Practicante Empresarial | People Analytics",
    role_en: "Business Intern | People Analytics",
    type_es: "Contrato de formación",
    type_en: "Training contract",
    start_es: "Ene. 2026",
    end_es: "Jul. 2026",
    start_en: "Jan. 2026",
    end_en: "Jul. 2026",
    duration_es: "7 meses",
    duration_en: "7 months",
    location: "Bogotá, Colombia · Híbrido",
    logo: "/logos/banco-bogota.png",
    bullets_es: [
      "Elaboré presentaciones de procesos de alto impacto para el área de Analítica de Talento.",
      "Apoyé en el seguimiento y control de procesos del área.",
      "Apoyé la adaptación de scripts locales en Jupyter para su ejecución en la nube.",
      "Apoyé en procesos de carga, organización y validación de datos.",
      "Apoyé la conexión de tableros en Power BI con fuentes de datos alojadas en Google Cloud.",
    ],
    bullets_en: [
      "Prepared high-impact process presentations for the Talent Analytics team.",
      "Supported process monitoring and control within the area.",
      "Assisted in adapting local Jupyter scripts for cloud execution.",
      "Supported data loading, organization, and validation processes.",
      "Assisted in connecting Power BI dashboards to Google Cloud data sources.",
    ],
  },
];
---

<section
  id="experiencia"
  class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20"
  aria-label="Experiencia"
>
  <div class="text-center mb-14">
    <h2
      class="text-4xl sm:text-5xl font-extrabold tracking-tight text-black dark:text-white mb-3"
      data-i18n="exp_title"
    >
      Experiencia
    </h2>
    <p
      class="text-neutral-600 dark:text-neutral-400 text-base sm:text-lg max-w-2xl mx-auto"
      data-i18n="exp_subtitle"
    >
      Trayectoria profesional y experiencia laboral.
    </p>
  </div>

  <div class="flex flex-col gap-6">
    {JOBS.map((job) => (
      <article
        class="backdrop-blur-xl bg-white/70 dark:bg-neutral-900/50
               border border-black/10 dark:border-white/10 rounded-2xl p-6 sm:p-8 shadow-lg"
      >
        <div class="flex items-start gap-4 sm:gap-6">
          <!-- Logo -->
          <div class="shrink-0 h-14 w-14 sm:h-16 sm:w-16 rounded-xl overflow-hidden
                      border border-black/10 dark:border-white/10 bg-white flex items-center justify-center shadow-sm">
            <img
              src={job.logo}
              alt={job.company}
              class="h-full w-full object-contain p-1"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <span
              class="hidden h-full w-full items-center justify-center text-lg font-bold text-red-600 select-none"
              aria-hidden="true"
            >
              BB
            </span>
          </div>

          <!-- Info principal -->
          <div class="flex-1 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold text-neutral-900 dark:text-white leading-tight">
              <span data-i18n="exp_banco_role">{job.role_es}</span>
            </h3>
            <p class="text-base font-semibold text-neutral-700 dark:text-neutral-300 mt-0.5">
              {job.company}
            </p>
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-1.5 text-sm text-neutral-500 dark:text-neutral-400">
              <span data-i18n="exp_banco_type">{job.type_es}</span>
              <span aria-hidden="true">·</span>
              <span>
                <span data-i18n="exp_banco_start">{job.start_es}</span>
                {" – "}
                <span data-i18n="exp_banco_end">{job.end_es}</span>
                {" · "}
                <span data-i18n="exp_banco_duration">{job.duration_es}</span>
              </span>
            </div>
            <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400 flex items-center gap-1">
              <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                <circle cx="12" cy="9" r="2.5" stroke-width="2"/>
              </svg>
              {job.location}
            </p>
          </div>
        </div>

        <!-- Bullets -->
        <ul class="mt-5 space-y-2 pl-1">
          {job.bullets_es.map((b, i) => (
            <li class="flex items-start gap-2.5 text-sm text-neutral-700 dark:text-neutral-300">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-lime-500" aria-hidden="true"></span>
              <span data-i18n={`exp_banco_b${i + 1}`}>{b}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
