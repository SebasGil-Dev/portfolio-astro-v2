---
const JOBS = [
  {
    id: "banco-bogota",
    company: "Banco de Bogotá",
    role_es: "Practicante Empresarial | People Analytics",
    role_en: "Business Intern | People Analytics",
    date_es: "Enero 2026 – Julio 2026",
    date_en: "January 2026 – July 2026",
    logo: "/logos/banco-bogota.png",
    desc_es: "Apoyé al área de Analítica de Talento elaborando presentaciones de procesos de alto impacto, adaptando scripts de Jupyter para ejecución en la nube, gestionando carga y validación de datos, y conectando tableros de Power BI con fuentes de datos en Google Cloud Platform.",
    desc_en: "Supported the Talent Analytics area by creating high-impact process presentations, adapting Jupyter scripts for cloud execution, managing data loading and validation, and connecting Power BI dashboards to Google Cloud Platform data sources.",
  },
];
---

<section
  id="experiencia"
  class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20"
  aria-label="Experiencia"
>
  <!-- Título -->
  <div class="text-center mb-14">
    <h2
      class="text-4xl sm:text-5xl font-extrabold tracking-tight text-black dark:text-white mb-3"
      data-i18n="exp_title"
    >
      Experiencia
    </h2>
    <p
      class="text-neutral-600 dark:text-neutral-400 text-base sm:text-lg max-w-2xl mx-auto"
      data-i18n="exp_subtitle"
    >
      Trayectoria profesional y experiencia laboral.
    </p>
  </div>

  <!-- Timeline -->
  <div class="relative">
    <div class="flex flex-col gap-12">
      {JOBS.map((job) => (
        <div class="relative pl-20">
          <!-- Línea vertical desde debajo del logo -->
          <div class="absolute left-[27px] top-20 bottom-[-3rem] w-px bg-neutral-200 dark:bg-neutral-700" aria-hidden="true"></div>
          <!-- Logo como marcador del timeline -->
          <div class="absolute left-0 top-0 h-16 w-16 rounded-xl overflow-hidden flex items-center justify-center">
            <img
              src={job.logo}
              alt={job.company}
              class="h-full w-full object-contain p-1"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <span class="hidden h-full w-full items-center justify-center text-xs font-bold text-red-600 select-none" aria-hidden="true">BB</span>
          </div>

          <div class="grid sm:grid-cols-[200px_1fr] gap-4 sm:gap-10">
            <!-- Columna izquierda: cargo + empresa + fecha -->
            <div class="flex flex-col gap-2">
              <div>
                <p class="text-base font-bold text-blue-500 dark:text-blue-400 leading-tight" data-i18n="exp_banco_role">
                  {job.role_es}
                </p>
                <p class="text-sm font-semibold text-neutral-800 dark:text-neutral-200 mt-0.5">
                  {job.company}
                </p>
                <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-0.5" data-i18n="exp_banco_date">
                  {job.date_es}
                </p>
              </div>
            </div>

            <!-- Columna derecha: descripción -->
            <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed pt-0 sm:pt-1" data-i18n="exp_banco_desc">
              {job.desc_es}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
