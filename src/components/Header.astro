---
import esFlag from "../assets/es.svg";
import enFlag from "../assets/en.svg"; 
---

<header
  class="fixed top-3 left-1/2 z-50 w-full max-w-6xl -translate-x-1/2 px-3 sm:px-4"
  role="banner"
>
  <div
    id="headerWrap"
    data-scrolled="false"
    class="
      relative rounded-full border border-transparent ring-0 shadow-none
      bg-transparent dark:bg-transparent backdrop-blur-0
      transition-all duration-500 ease-in-out

      data-[scrolled=true]:border-neutral-900/10
      dark:data-[scrolled=true]:border-white/12
      data-[scrolled=true]:ring-1 data-[scrolled=true]:ring-black/5
      dark:data-[scrolled=true]:ring-white/5
      data-[scrolled=true]:shadow-lg

      data-[scrolled=true]:bg-white/60
      dark:data-[scrolled=true]:bg-neutral-900/60

      data-[scrolled=true]:backdrop-blur-md
    "
  >
    <nav
      class="relative z-10 flex min-h-12 items-center justify-between gap-2 sm:gap-4 px-3 sm:px-6 py-2"
      aria-label="Navegación principal"
    >
      <!-- Izquierda -->
      <a href="/" class="group shrink-0 inline-flex items-center" aria-label="Inicio">
        <div
          class="relative h-9 w-9 sm:h-10 sm:w-10 overflow-hidden rounded-full ring-2 ring-white/40 dark:ring-white/10 shadow-sm
                transition-all duration-500 ease-in-out
                group-hover:scale-110 group-focus-visible:scale-110"
        >
          <video
            src="/profile.webm"
            autoplay muted loop playsinline
            class="absolute inset-0 h-full w-full object-cover object-center
                  scale-[1.2] transition-transform duration-500 ease-in-out
                  group-hover:scale-[1.3] group-focus-visible:scale-[1.3]"
          ></video>
        </div>
      </a>

<!-- Centro -->
<ul
  class="flex-1 min-w-0 flex items-center justify-center
        overflow-x-auto whitespace-nowrap
        gap-3 sm:gap-6 text-[13px] sm:text-sm font-medium
        [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden
        max-[480px]:gap-2"
>
  <!-- Sobre mí -->
  <li class="group shrink-0">
    <a href="#sobre-mi"
       class="relative inline-flex items-center px-1 py-0.5
              text-neutral-700 hover:text-neutral-900 dark:text-neutral-200 dark:hover:text-white
              transition-[transform,color] duration-300 ease-out
              group-hover:scale-110 group-focus-visible:scale-110
              focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40 rounded-md
              max-[480px]:px-0.5">

      <!-- Icono: visible < 480px -->
      <svg class="hidden max-[480px]:inline-block h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <!-- user -->
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 14a4 4 0 10-8 0v2a2 2 0 002 2h4a2 2 0 002-2v-2z" />
        <circle cx="12" cy="8" r="3" stroke-width="1.5"/>
      </svg>

      <!-- Texto: oculto < 480px -->
      <span data-i18n="about" class="max-[480px]:hidden">Sobre mí</span>

      <span class="pointer-events-none absolute -bottom-1 left-0 h-0.5 w-0 bg-current opacity-40 transition-all duration-300 ease-out group-hover:w-full group-focus-visible:w-full"></span>
    </a>
  </li>

  <!-- Habilidades -->
  <li class="group shrink-0">
    <a href="#habilidades" class="relative inline-flex items-center px-1 py-0.5 text-neutral-700 hover:text-neutral-900 dark:text-neutral-200 dark:hover:text-white transition-[transform,color] duration-300 ease-out group-hover:scale-110 group-focus-visible:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40 rounded-md max-[480px]:px-0.5">
      <svg class="hidden max-[480px]:inline-block h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <!-- sparkles -->
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3l1.5 3L10 7l-3.5 1L5 11l-1.5-3L0 7l3.5-1L5 3zM19 3l2 4 4 2-4 2-2 4-2-4-4-2 4-2 2-4zM9 14l1 2 2 1-2 1-1 2-1-2-2-1 2-1 1-2z"/>
      </svg>
      <span data-i18n="skills" class="max-[480px]:hidden">Habilidades</span>
      <span class="pointer-events-none absolute -bottom-1 left-0 h-0.5 w-0 bg-current opacity-40 transition-all duration-300 ease-out group-hover:w-full group-focus-visible:w-full"></span>
    </a>
  </li>

    <!-- Certificados -->
  <li class="group shrink-0">
    <a href="#certificados"
       class="relative inline-flex items-center px-1 py-0.5
              text-neutral-700 hover:text-neutral-900 dark:text-neutral-200 dark:hover:text-white
              transition-[transform,color] duration-300 ease-out
              group-hover:scale-110 group-focus-visible:scale-110
              focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40 rounded-md
              max-[480px]:px-0.5">

      <!-- Icono: visible < 480px -->
      <svg class="hidden max-[480px]:inline-block h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <!-- certificado (medalla) -->
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M12 15.5a6 6 0 1 1 0-12 6 6 0 0 1 0 12z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M9.5 14.5L8 21l4-2 4 2-1.5-6.5" />
      </svg>

      <!-- Texto: oculto < 480px -->
      <span data-i18n="certificates" class="max-[480px]:hidden">Certificados</span>

      <span class="pointer-events-none absolute -bottom-1 left-0 h-0.5 w-0 bg-current opacity-40 transition-all duration-300 ease-out group-hover:w-full group-focus-visible:w-full"></span>
    </a>
  </li>


  <!-- Proyectos -->
  <li class="group shrink-0">
    <a href="#proyectos" class="relative inline-flex items-center px-1 py-0.5 text-neutral-700 hover:text-neutral-900 dark:text-neutral-200 dark:hover:text-white transition-[transform,color] duration-300 ease-out group-hover:scale-110 group-focus-visible:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40 rounded-md max-[480px]:px-0.5">
      <svg class="hidden max-[480px]:inline-block h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <!-- folder -->
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7h6l2 2h10v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/>
      </svg>
      <span data-i18n="projects" class="max-[480px]:hidden">Proyectos</span>
      <span class="pointer-events-none absolute -bottom-1 left-0 h-0.5 w-0 bg-current opacity-40 transition-all duration-300 ease-out group-hover:w-full group-focus-visible:w-full"></span>
    </a>
  </li>

  <!-- Contacto -->
  <li class="group shrink-0">
    <a href="#contacto" class="relative inline-flex items-center px-1 py-0.5 text-neutral-700 hover:text-neutral-900 dark:text-neutral-200 dark:hover:text-white transition-[transform,color] duration-300 ease-out group-hover:scale-110 group-focus-visible:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40 rounded-md max-[480px]:px-0.5">
      <svg class="hidden max-[480px]:inline-block h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <!-- mail -->
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M22 8l-10 6L2 8"/>
      </svg>
      <span data-i18n="contact" class="max-[480px]:hidden">Contacto</span>
      <span class="pointer-events-none absolute -bottom-1 left-0 h-0.5 w-0 bg-current opacity-40 transition-all duration-300 ease-out group-hover:w-full group-focus-visible:w-full"></span>
    </a>
  </li>
</ul>


      <!-- Derecha -->
      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <!-- Tema -->
        <button
          type="button"
          aria-label="Cambiar tema"
          class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-black/10 bg-white/70 ring-1 ring-black/5 backdrop-blur-sm
                hover:bg-white/80 active:scale-95
                dark:border-white/10 dark:bg-neutral-900/70 dark:ring-white/5 dark:hover:bg-neutral-900/80
                transition-all duration-300 ease-out hover:scale-110 focus-visible:scale-110
                focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40"
          data-theme-toggle
          title="Tema"
        >
          <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <circle cx="12" cy="12" r="4" stroke-width="1.5" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4l1.4-1.4M17 7l1.4-1.4"/>
          </svg>
          <svg class="hidden h-5 w-5 dark:inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/>
          </svg>
        </button>

        <!-- Idioma -->
        <button
          type="button"
          data-lang-toggle               
          aria-label="Cambiar idioma"
          class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-black/10 bg-white/70 ring-1 ring-black/5 backdrop-blur-sm
                hover:bg-white/80 active:scale-95
                dark:border-white/10 dark:bg-neutral-900/70 dark:ring-white/5 dark:hover:bg-neutral-900/80
                transition-all duration-300 ease-out hover:scale-110 focus-visible:scale-110
                focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40 overflow-hidden"
          title="Idioma"
        >
          <img
            data-lang-flag               
            src={esFlag.src}
            alt="Idioma actual"
            class="h-5 w-5 object-cover rounded-full"
          />
        </button>

      </div>
    </nav>
  </div>
</header>

<!-- Mantengo solo lo necesario: tema + borde al hacer scroll -->
<script is:inline type="module">
  // --- Tema ---
  const THEME_KEY = 'theme';
  const getTheme = () => {
    try {
      const s = localStorage.getItem(THEME_KEY);
      if (s === 'dark' || s === 'light') return s;
    } catch {}
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };
  const applyTheme = (mode, persist=false) => {
    const isDark = mode === 'dark';
    document.documentElement.classList.toggle('dark', isDark);
    if (persist) try { localStorage.setItem(THEME_KEY, mode); } catch {}
  };
  const toggleTheme = () => applyTheme(getTheme() === 'dark' ? 'light' : 'dark', true);

  // --- Scroll state (para borde/sombra al bajar) ---
  const setupScroll = () => {
    const wrap = document.getElementById('headerWrap');
    if (!wrap) return;
    const apply = () => { wrap.dataset.scrolled = window.scrollY > 0 ? 'true' : 'false'; };
    apply();
    const raf = fn => () => requestAnimationFrame(fn);
    window.addEventListener('scroll', raf(apply), { passive: true });
    window.addEventListener('resize', raf(apply), { passive: true });
  };

  document.addEventListener('DOMContentLoaded', () => {
    applyTheme(getTheme());
    document.querySelectorAll('[data-theme-toggle]').forEach(b => b.addEventListener('click', toggleTheme));
    setupScroll(); // <- mantiene el efecto del borde/sombra al hacer scroll
  });
</script>
