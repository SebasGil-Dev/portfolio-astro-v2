---
import lang from "../i18n/lang.json";

// Idioma por defecto:
const DEFAULT_LANG = "es";
// Serialización segura para inyectar en el script sin JSON.parse:
const I18N_JSON = JSON.stringify(lang);
---

<a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-black/80 focus:px-3 focus:py-2 focus:text-white" data-i18n="aria.skip">
  Saltar al contenido
</a>

<header class="fixed top-3 left-1/2 z-50 w-full max-w-3xl -translate-x-1/2 px-4 md:px-6" role="banner">
  <div class="rounded-2xl border border-white/30 bg-white/70 shadow-lg ring-1 ring-black/5 backdrop-blur-md supports-[backdrop-filter]:bg-white/60 dark:border-white/10 dark:bg-neutral-900/60 dark:ring-white/5">
    <nav class="flex items-center justify-between gap-3 px-4 py-2 md:px-6 md:py-3" aria-label="Navegación principal">
      <!-- Branding -->
      <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold tracking-tight" aria-label="" data-i18n-aria="aria.goHome">
        <img src="/profile.jpg" alt="" class="h-7 w-7 rounded-full ring-1 ring-black/10 dark:ring-white/10" />
        <span class="hidden sm:inline" data-i18n="brand">TuNombre.dev</span>
      </a>

      <!-- Menú desktop -->
      <ul class="hidden items-center gap-1 md:flex">
        <li><a href="#inicio" class="rounded-xl px-3 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-900/5 hover:text-neutral-900 dark:text-neutral-200 dark:hover:bg-white/5 dark:hover:text-white" data-i18n="nav.home">Inicio</a></li>
        <li><a href="#proyectos" class="rounded-xl px-3 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-900/5 hover:text-neutral-900 dark:text-neutral-200 dark:hover:bg-white/5 dark:hover:text-white" data-i18n="nav.projects">Proyectos</a></li>
        <li><a href="#sobre-mi" class="rounded-xl px-3 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-900/5 hover:text-neutral-900 dark:text-neutral-200 dark:hover:bg-white/5 dark:hover:text-white" data-i18n="nav.about">Sobre mí</a></li>
        <li><a href="#contacto" class="rounded-xl px-3 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-900/5 hover:text-neutral-900 dark:text-neutral-200 dark:hover:bg-white/5 dark:hover:text-white" data-i18n="nav.contact">Contacto</a></li>

        <!-- Botón único de idioma -->
        <li class="ml-1">
          <button
            data-lang-switch
            class="rounded-xl px-3 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-900/5 hover:text-neutral-900 dark:text-neutral-200 dark:hover:bg-white/5 dark:hover:text-white"
            type="button"
            data-i18n="langButton"
            data-i18n-aria="aria.toggleLang"
          >ES</button>
        </li>
      </ul>

      <!-- Menú mobile -->
      <details class="relative md:hidden">
        <summary class="list-none rounded-xl px-2 py-2 hover:bg-neutral-900/5 dark:hover:bg-white/5" aria-label="" data-i18n-aria="aria.openMenu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </summary>

        <div class="absolute right-0 mt-2 w-56 overflow-hidden rounded-xl border border-white/30 bg-white/80 p-2 shadow-lg ring-1 ring-black/5 backdrop-blur-md supports-[backdrop-filter]:bg-white/60 dark:border-white/10 dark:bg-neutral-900/70 dark:ring-white/5">
          <a href="#inicio" class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-neutral-900/5 dark:hover:bg-white/5" data-i18n="nav.home">Inicio</a>
          <a href="#proyectos" class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-neutral-900/5 dark:hover:bg-white/5" data-i18n="nav.projects">Proyectos</a>
          <a href="#sobre-mi" class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-neutral-900/5 dark:hover:bg-white/5" data-i18n="nav.about">Sobre mí</a>
          <a href="#contacto" class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-neutral-900/5 dark:hover:bg-white/5" data-i18n="nav.contact">Contacto</a>
          <div class="my-1 h-px bg-neutral-900/10 dark:bg-white/10"></div>
          <button
            data-lang-switch
            class="w-full rounded-lg px-3 py-2 text-left text-sm hover:bg-neutral-900/5 dark:hover:bg-white/5"
            type="button"
            data-i18n="langButton"
            data-i18n-aria="aria.toggleLang"
          >ES</button>
        </div>
      </details>
    </nav>
  </div>
</header>

<!-- Script: sin JSON.parse, inyectamos el objeto directamente -->
<script is:inline type="module">
  // Datos inyectados desde el frontmatter (correcto y válido)
  const TRANSLATIONS = JSON.parse(`${I18N.JSON}`);
  const DEFAULT_LANG = `${DEFAULT_LANG}`;


  const resolve = (obj, path) => path.split(".").reduce((acc, k) => (acc && acc[k] !== undefined ? acc[k] : undefined), obj);

  const getInitialLang = () => {
    const stored = localStorage.getItem("lang");
    if (stored && TRANSLATIONS[stored]) return stored;
    const htmlLang = document.documentElement.getAttribute("lang");
    if (htmlLang && TRANSLATIONS[htmlLang]) return htmlLang;
    return (navigator.language || "es").toLowerCase().startsWith("es") ? "es" : DEFAULT_LANG;
  };

  const applyI18N = (code) => {
    const t = TRANSLATIONS[code] || TRANSLATIONS[DEFAULT_LANG];

    // Etiquetas visibles
    document.querySelectorAll("[data-i18n]").forEach((el) => {
      const key = el.getAttribute("data-i18n");
      const val = resolve(t, key);
      if (typeof val === "string") el.textContent = val;
    });

    // ARIA
    document.querySelectorAll("[data-i18n-aria]").forEach((el) => {
      const key = el.getAttribute("data-i18n-aria");
      const val = resolve(t, key);
      if (typeof val === "string") el.setAttribute("aria-label", val);
    });

    // html[lang]
    document.documentElement.setAttribute("lang", code);
    localStorage.setItem("lang", code);
  };

  // Wire: un único selector para ambos botones
  const wireSwitchers = () => {
    document.querySelectorAll("[data-lang-switch]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const current = localStorage.getItem("lang") || getInitialLang();
        const next = current === "es" ? "en" : "es";
        applyI18N(next);
      });
    });
  };

  // Init
  applyI18N(getInitialLang());
  wireSwitchers();
</script>
