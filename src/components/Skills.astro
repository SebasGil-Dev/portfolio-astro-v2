---
import htmlIcon from "../assets/skills/html.svg";
import cssIcon from "../assets/skills/css.svg";
import jsIcon from "../assets/skills/javascript.svg";
import pythonIcon from "../assets/skills/python.svg";
import sqlIcon from "../assets/skills/sql.svg";
import powerbiIcon from "../assets/skills/powerbi.svg";
import gcpIcon from "../assets/skills/googlecloud.svg";
import pandasIcon from "../assets/skills/pandas.svg";
import numpyIcon from "../assets/skills/numpy.svg";
import jupyterIcon from "../assets/skills/jupyter.svg";
import excelIcon from "../assets/skills/excel.svg";

import teamworkIcon from "../assets/skills/teamwork.svg";
import communicationIcon from "../assets/skills/communication.svg";
import adaptabilityIcon from "../assets/skills/adaptability.svg";
import decisionIcon from "../assets/skills/decision.svg";
import problemIcon from "../assets/skills/problem-solving.svg";

const technicalSkills = [
  { key: "skill_python",  icon: pythonIcon },
  { key: "skill_sql",     icon: sqlIcon },
  { key: "skill_powerbi", icon: powerbiIcon },
  { key: "skill_gcp",     icon: gcpIcon },
  { key: "skill_pandas",  icon: pandasIcon },
  { key: "skill_numpy",   icon: numpyIcon },
  { key: "skill_jupyter", icon: jupyterIcon },
  { key: "skill_excel",   icon: excelIcon },
  { key: "skill_html",    icon: htmlIcon },
  { key: "skill_css",     icon: cssIcon },
  { key: "skill_js",      icon: jsIcon },
];

const softSkills = [
  { key: "soft_teamwork",     icon: teamworkIcon },
  { key: "soft_communication",icon: communicationIcon },
  { key: "soft_adaptability", icon: adaptabilityIcon },
  { key: "soft_decision",     icon: decisionIcon },
  { key: "soft_problem",      icon: problemIcon },
];
---

<section
  id="habilidades"
  class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20"
  aria-label="Habilidades"
>
  <div class="text-center mb-14">
    <h2
      class="text-4xl sm:text-5xl font-extrabold tracking-tight
         text-black dark:text-white mb-3"
      data-i18n="skills_title"
    >
      Habilidades
    </h2>

    <p
      class="text-neutral-600 dark:text-neutral-400 text-base sm:text-lg max-w-2xl mx-auto"
      data-i18n="skills_description"
    >
      Combinación de habilidades técnicas y blandas que me permiten crear proyectos funcionales, eficientes y colaborativos.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
    <!-- Técnicas -->
    <div
      class="backdrop-blur-xl bg-white/70 dark:bg-neutral-900/50
             border border-black/10 dark:border-white/10 rounded-2xl p-8 shadow-lg"
    >
      <h3
        class="text-2xl font-semibold mb-6 flex items-center justify-center gap-2
               text-center text-neutral-900 dark:text-white"
        data-i18n="skills_tech"
      >
        Técnicas
      </h3>

      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5">
        {technicalSkills.map(s => (
          <li
            class="flex flex-col items-center justify-center gap-3 rounded-xl
                   bg-white/80 dark:bg-neutral-800/70 border border-black/5 dark:border-white/10
                   shadow-sm hover:shadow-md transition-transform hover:scale-105 p-3 sm:p-4"
          >
            <img
              src={s.icon.src}
              alt=""
              class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8 lg:h-9 lg:w-9
                     object-contain transition-all duration-300 dark:invert-0 invert"
              loading="lazy"
              decoding="async"
            />
            <span
              class="text-[13px] sm:text-sm font-medium text-neutral-800 dark:text-neutral-200 text-center"
              data-i18n={s.key}
            >
              <!-- Fallback ES (opcional, por si el script tarda) -->
              {s.key}
            </span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Blandas -->
    <div
      class="backdrop-blur-xl bg-white/70 dark:bg-neutral-900/50
             border border-black/10 dark:border-white/10 rounded-2xl p-8 shadow-lg"
    >
      <h3
        class="text-2xl font-semibold mb-6 flex items-center justify-center gap-2
               text-center text-neutral-900 dark:text-white"
        data-i18n="skills_soft"
      >
        Blandas
      </h3>

      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5">
        {softSkills.map(s => (
          <li
            class="flex flex-col items-center justify-center gap-3 rounded-xl
                   bg-white/80 dark:bg-neutral-800/70 border border-black/5 dark:border-white/10
                   shadow-sm hover:shadow-md transition-transform hover:scale-105 p-3 sm:p-4"
          >
            <img
              src={s.icon.src}
              alt=""
              class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8 lg:h-9 lg:w-9
                     object-contain transition-all duration-300 dark:invert-0 invert"
              loading="lazy"
              decoding="async"
            />
            <span
              class="text-[13px] sm:text-sm font-medium text-neutral-800 dark:text-neutral-200 text-center"
              data-i18n={s.key}
            >
              {s.key}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

</section>
